// 10. STRING ALGORITHMS  (atcoder::z_algorithm,suffix_array, lcp_array)
vector<int> z_algorithm(const string& s) {
    int n = sz(s);
    vector<int> z(n, 0);
    z[0] = n;
    int l = 0, r = 0;
    for (int i = 1; i < n; i++) {
        if (i < r) z[i] = min(r - i, z[i - l]);
        while (i + z[i] < n && s[z[i]] == s[i + z[i]]) z[i]++;
        if (i + z[i] > r) { l = i; r = i + z[i]; }
    }
    return z;
}
vector<int> suffix_array(const string& s) {
    int n = sz(s);
    vector<int> sa(n), rnk(n), tmp(n);
    for (int i = 0; i < n; i++) { sa[i] = i; rnk[i] = (unsigned char)s[i]; }
    for (int k = 1; k < n; k <<= 1) {
        auto cmp = [&](int a, int b) {
            if (rnk[a] != rnk[b]) return rnk[a] < rnk[b];
            int ra = a + k < n ? rnk[a + k] : -1;
            int rb = b + k < n ? rnk[b + k] : -1;
            return ra < rb;
        };
        sort(all(sa), cmp);
        tmp[sa[0]] = 0;
        for (int i = 1; i < n; i++) tmp[sa[i]] = tmp[sa[i - 1]] + (cmp(sa[i - 1], sa[i]) ? 1 : 0);
        rnk = tmp;
    }
    return sa;
}
vector<int> lcp_array(const string& s, const vector<int>& sa) {
    int n = sz(s);
    vector<int> rnk(n), lcp(max(n - 1, 0));
    for (int i = 0; i < n; i++) rnk[sa[i]] = i;
    int h = 0;
    for (int i = 0; i < n; i++) {
        if (rnk[i] > 0) {
            int j = sa[rnk[i] - 1];
            while (i + h < n && j + h < n && s[i + h] == s[j + h]) h++;
            lcp[rnk[i] - 1] = h;
            if (h > 0) h--;
        } else h = 0;
    }
    return lcp;
}

vector<int> suffix_array_fast(const string& s) {
    int n = sz(s);
    if (n == 1) return {0};
    int M = max(n, 256) + 1;
    vector<int> sa(n), rnk(n), tmp(n), nr(n), cnt(M, 0);
    for (int i = 0; i < n; i++) { rnk[i] = (unsigned char)s[i]; cnt[rnk[i]]++; }
    for (int i = 1; i < M; i++) cnt[i] += cnt[i - 1];
    for (int i = n - 1; i >= 0; i--) sa[--cnt[rnk[i]]] = i;
    for (int k = 1; k < n; k <<= 1) {
        int p = 0;
        for (int i = n - k; i < n; i++) tmp[p++] = i;          // empty second key sorts first
        for (int j = 0; j < n; j++) if (sa[j] >= k) tmp[p++] = sa[j] - k;
        fill(all(cnt), 0);
        for (int i = 0; i < n; i++) cnt[rnk[i]]++;
        for (int i = 1; i < M; i++) cnt[i] += cnt[i - 1];
        for (int i = n - 1; i >= 0; i--) sa[--cnt[rnk[tmp[i]]]] = tmp[i];
        nr[sa[0]] = 0;
        int classes = 1;
        for (int i = 1; i < n; i++) {
            int a = sa[i - 1], b = sa[i];
            int a2 = a + k < n ? rnk[a + k] : -1;
            int b2 = b + k < n ? rnk[b + k] : -1;
            if (rnk[a] != rnk[b] || a2 != b2) classes++;
            nr[b] = classes - 1;
        }
        rnk = nr;
        if (classes == n) break;
    }
    return sa;
}
