// 1. MODINT  (atcoder::static_modint / atcoder::dynamic_modint)
template <int MOD>
struct static_modint {
    int val;
    static_modint() : val(0) {}
    static_modint(ll v) { v %= MOD; if (v < 0) v += MOD; val = (int)v; }

    static_modint& operator+=(const static_modint& o) { val += o.val; if (val >= MOD) val -= MOD; return *this; }
    static_modint& operator-=(const static_modint& o) { val -= o.val; if (val < 0) val += MOD; return *this; }
    static_modint& operator*=(const static_modint& o) { val = (int)((ll)val * o.val % MOD); return *this; }
    static_modint& operator/=(const static_modint& o) { return *this *= o.inv(); }
    static_modint operator+(const static_modint& o) const { return static_modint(*this) += o; }
    static_modint operator-(const static_modint& o) const { return static_modint(*this) -= o; }
    static_modint operator*(const static_modint& o) const { return static_modint(*this) *= o; }
    static_modint operator/(const static_modint& o) const { return static_modint(*this) /= o; }
    static_modint operator-() const { return static_modint(-val); }

    static_modint pow(ll n) const {
        static_modint base = *this, res = 1;
        while (n > 0) { if (n & 1) res *= base; base *= base; n >>= 1; }
        return res;
    }
    static_modint inv() const { return pow(MOD - 2); } // MOD must be prime

    bool operator==(const static_modint& o) const { return val == o.val; }
    bool operator!=(const static_modint& o) const { return val != o.val; }
    friend ostream& operator<<(ostream& os, const static_modint& m) { return os << m.val; }
    friend istream& operator>>(istream& is, static_modint& m) { ll x; is >> x; m = static_modint(x); return is; }
};
using modint998244353 = static_modint<998244353>;
using modint1000000007 = static_modint<1000000007>;

struct dynamic_modint {
    static int MOD;
    int val;
    dynamic_modint() : val(0) {}
    dynamic_modint(ll v) { v %= MOD; if (v < 0) v += MOD; val = (int)v; }
    static void set_mod(int m) { MOD = m; }

    dynamic_modint& operator+=(const dynamic_modint& o) { val += o.val; if (val >= MOD) val -= MOD; return *this; }
    dynamic_modint& operator-=(const dynamic_modint& o) { val -= o.val; if (val < 0) val += MOD; return *this; }
    dynamic_modint& operator*=(const dynamic_modint& o) { val = (int)((ll)val * o.val % MOD); return *this; }
    dynamic_modint& operator/=(const dynamic_modint& o) { return *this *= o.inv(); }
    dynamic_modint operator+(const dynamic_modint& o) const { return dynamic_modint(*this) += o; }
    dynamic_modint operator-(const dynamic_modint& o) const { return dynamic_modint(*this) -= o; }
    dynamic_modint operator*(const dynamic_modint& o) const { return dynamic_modint(*this) *= o; }
    dynamic_modint operator/(const dynamic_modint& o) const { return dynamic_modint(*this) /= o; }

    dynamic_modint pow(ll n) const {
        dynamic_modint base = *this, res = 1;
        while (n > 0) { if (n & 1) res *= base; base *= base; n >>= 1; }
        return res;
    }
    dynamic_modint inv() const { // extended Euclid — works for non-prime MOD too
        ll a = val, m = MOD, x = 1, y = 0;
        while (a != 0) { ll t = m / a; m -= t * a; swap(a, m); x -= t * y; swap(x, y); }
        return dynamic_modint((x % (ll)MOD + MOD) % MOD);
    }
    friend ostream& operator<<(ostream& os, const dynamic_modint& m) { return os << m.val; }
};
int dynamic_modint::MOD = 1;
