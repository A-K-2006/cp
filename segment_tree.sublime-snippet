// SEGMENT TREE  (atcoder::segtree<S, op, e>)
template <class S, S (*op)(S, S), S (*e)()>
struct segtree {
    int _n, size, log;
    vector<S> d;
    segtree() : segtree(0) {}
    segtree(int n) : segtree(vector<S>(n, e())) {}
    segtree(const vector<S>& v) : _n(sz(v)) {
        log = 0; while ((1 << log) < _n) log++;
        size = 1 << log;
        d = vector<S>(2 * size, e());
        for (int i = 0; i < _n; i++) d[size + i] = v[i];
        for (int i = size - 1; i >= 1; i--) upd(i);
    }
    void upd(int k) { d[k] = op(d[2 * k], d[2 * k + 1]); }
    void set(int p, S x) { p += size; d[p] = x; for (int i = 1; i <= log; i++) upd(p >> i); }
    S get(int p) { return d[p + size]; }
    S prod(int l, int r) { // [l, r)
        S sml = e(), smr = e();
        l += size; r += size;
        while (l < r) {
            if (l & 1) sml = op(sml, d[l++]);
            if (r & 1) smr = op(d[--r], smr);
            l >>= 1; r >>= 1;
        }
        return op(sml, smr);
    }
    S all_prod() { return d[1]; }
    // first index in [l, n) where f(prod(l, idx+1)) becomes false; requires f(e())==true
    int max_right(int l, function<bool(S)> f) {
        if (l == _n) return _n;
        l += size;
        S sm = e();
        do {
            while (l % 2 == 0) l >>= 1;
            if (!f(op(sm, d[l]))) {
                while (l < size) { l = 2 * l; if (f(op(sm, d[l]))) { sm = op(sm, d[l]); l++; } }
                return l - size;
            }
            sm = op(sm, d[l]); l++;
        } while ((l & (-l)) != l);
        return _n;
    }
    // last index in [0, r] such that f(prod(idx, r)) is true, scanning from r downward
    int min_left(int r, function<bool(S)> f) {
        if (r == 0) return 0;
        r += size;
        S sm = e();
        do {
            r--;
            while (r > 1 && (r % 2)) r >>= 1;
            if (!f(op(d[r], sm))) {
                while (r < size) { r = 2 * r + 1; if (f(op(d[r], sm))) { sm = op(d[r], sm); r--; } }
                return r + 1 - size;
            }
            sm = op(d[r], sm);
        } while ((r & (-r)) != r);
        return 0;
    }
};

// LAZY SEGMENT TREE  (atcoder::lazy_segtree<S,op,e,F,mapping,composition,id>)
template <class S, S (*op)(S, S), S (*e)(),
          class F, S (*mapping)(F, S), F (*composition)(F, F), F (*id)()>
struct lazy_segtree {
    int _n, size, log;
    vector<S> d;
    vector<F> lz;
    lazy_segtree() : lazy_segtree(0) {}
    lazy_segtree(int n) : lazy_segtree(vector<S>(n, e())) {}
    lazy_segtree(const vector<S>& v) : _n(sz(v)) {
        log = 0; while ((1 << log) < _n) log++;
        size = 1 << log;
        d = vector<S>(2 * size, e());
        lz = vector<F>(size, id());
        for (int i = 0; i < _n; i++) d[size + i] = v[i];
        for (int i = size - 1; i >= 1; i--) upd(i);
    }
    void upd(int k) { d[k] = op(d[2 * k], d[2 * k + 1]); }
    void all_apply(int k, F f) { d[k] = mapping(f, d[k]); if (k < size) lz[k] = composition(f, lz[k]); }
    void push(int k) { all_apply(2 * k, lz[k]); all_apply(2 * k + 1, lz[k]); lz[k] = id(); }

    void set(int p, S x) {
        p += size;
        for (int i = log; i >= 1; i--) push(p >> i);
        d[p] = x;
        for (int i = 1; i <= log; i++) upd(p >> i);
    }
    S get(int p) {
        p += size;
        for (int i = log; i >= 1; i--) push(p >> i);
        return d[p];
    }
    S prod(int l, int r) { // [l, r)
        if (l == r) return e();
        l += size; r += size;
        for (int i = log; i >= 1; i--) {
            if (((l >> i) << i) != l) push(l >> i);
            if (((r >> i) << i) != r) push((r - 1) >> i);
        }
        S sml = e(), smr = e();
        while (l < r) {
            if (l & 1) sml = op(sml, d[l++]);
            if (r & 1) smr = op(d[--r], smr);
            l >>= 1; r >>= 1;
        }
        return op(sml, smr);
    }
    S all_prod() { return d[1]; }
    void apply(int p, F f) {
        p += size;
        for (int i = log; i >= 1; i--) push(p >> i);
        d[p] = mapping(f, d[p]);
        for (int i = 1; i <= log; i++) upd(p >> i);
    }
    void apply(int l, int r, F f) { // [l, r)
        if (l == r) return;
        l += size; r += size;
        for (int i = log; i >= 1; i--) {
            if (((l >> i) << i) != l) push(l >> i);
            if (((r >> i) << i) != r) push((r - 1) >> i);
        }
        int l2 = l, r2 = r;
        while (l < r) {
            if (l & 1) all_apply(l++, f);
            if (r & 1) all_apply(--r, f);
            l >>= 1; r >>= 1;
        }
        l = l2; r = r2;
        for (int i = 1; i <= log; i++) {
            if (((l >> i) << i) != l) upd(l >> i);
            if (((r >> i) << i) != r) upd((r - 1) >> i);
        }
    }
};

// PERSISTENT SEGMENT TREE
template <class S, S (*op)(S, S), S (*e)()>
struct persistent_segtree {
    struct node { S val; int l, r; };
    int _n;
    vector<node> t;

    persistent_segtree() : persistent_segtree(0) {}
    persistent_segtree(int n, int expected_updates = 0) : _n(n) {
        int lg = 1; while ((1 << lg) < max(n, 1)) lg++;
        t.reserve(1 + (size_t)expected_updates * (lg + 2));
        t.push_back({e(), 0, 0});
    }
    int empty_root() const { return 0; }
    int build(const vector<S>& v) { return _build(0, _n, v); }
    int set(int root, int p, S x) { return _set(root, 0, _n, p, x); }
    int apply(int root, int p, function<S(S)> f) { return set(root, p, f(get(root, p))); }
    S get(int root, int p) { return prod(root, p, p + 1); }
    S prod(int root, int l, int r) { return _prod(root, 0, _n, l, r); } 
    S all_prod(int root) { return t[root].val; }
    int kth(int ru, int rv, int k) {
        int lo = 0, hi = _n;
        while (hi - lo > 1) {
            int mid = (lo + hi) / 2;
            auto cl = t[t[rv].l].val - t[t[ru].l].val;
            if (k <= cl) { ru = t[ru].l; rv = t[rv].l; hi = mid; }
            else         { k -= cl; ru = t[ru].r; rv = t[rv].r; lo = mid; }
        }
        return lo;
    }
private:
    int _build(int lo, int hi, const vector<S>& v) {
        int nw = t.size(); t.push_back({e(), 0, 0});
        if (hi - lo == 1) { t[nw].val = v[lo]; return nw; }
        int mid = (lo + hi) / 2;
        int a = _build(lo, mid, v);
        int b = _build(mid, hi, v);
        t[nw].l = a; t[nw].r = b;
        t[nw].val = op(t[a].val, t[b].val);
        return nw;
    }
    int _set(int cur, int lo, int hi, int p, S x) {
        int nw = t.size(); t.push_back(t[cur]);
        if (hi - lo == 1) { t[nw].val = x; return nw; }
        int mid = (lo + hi) / 2;
        if (p < mid) { int c = _set(t[cur].l, lo, mid, p, x); t[nw].l = c; }
        else         { int c = _set(t[cur].r, mid, hi, p, x); t[nw].r = c; }
        t[nw].val = op(t[t[nw].l].val, t[t[nw].r].val);
        return nw;
    }
    S _prod(int cur, int lo, int hi, int l, int r) {
        if (cur == 0 || r <= lo || hi <= l) return e();
        if (l <= lo && hi <= r) return t[cur].val;
        int mid = (lo + hi) / 2;
        return op(_prod(t[cur].l, lo, mid, l, r), _prod(t[cur].r, mid, hi, l, r));
    }
};

